# Docker Compose Environment Variables
# Rename to .env or .env.local for docker compose to load automatically

# Environment Mode
NODE_ENV=development

# Database Configuration
DB_USER=unissential_user
DB_PASSWORD=unissential_password
DB_NAME=unissential_db
DB_PORT=5432

# Backend Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-minimum-32-chars
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:3000
PORT=5000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
