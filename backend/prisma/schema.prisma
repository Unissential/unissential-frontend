// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  password            String
  university          String
  isVerified          Boolean   @default(false)
  verificationToken   String?   @unique
  verificationExpires DateTime?
  profilePicture      String?
  bio                 String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  listings            Listing[]
  marketplaceProducts MarketplaceProduct[]
  savedProducts       SavedProduct[]
  roommateProfile     RoommateProfile?
  savedItems          SavedItem[]
  sentMessages        Message[] @relation("sender")
  conversations       ConversationParticipant[]
  notifications       Notification[]

  @@index([email])
}

// Leasing Listing model
model Listing {
  id              String    @id @default(cuid())
  title           String
  description     String    @db.Text
  price           Float
  location        String
  university      String?   // Target university
  latitude        Float?
  longitude       Float?
  images          String[]  // JSON array of image URLs
  amenities       String[]  // JSON array of amenities
  bedrooms        Int
  bathrooms       Int
  furnished       Boolean   @default(false)
  availableFrom   DateTime? // When the listing becomes available
  availableTo     DateTime? // When the lease ends
  leaseDuration   String?   // "flexible" | "3-months" | "6-months" | "12-months"
  isAvailable     Boolean   @default(true)
  petFriendly     Boolean   @default(false)
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  savedBy         SavedItem[]

  @@index([ownerId])
  @@index([location])
  @@index([university])
  @@index([isAvailable])
  @@index([createdAt])
}

// Roommate Profile model
model RoommateProfile {
  id           String   @id @default(cuid())
  age          Int
  university   String
  major        String?
  budget       Float
  interests    String[] // JSON array of interests
  sleepSchedule String  // "early_bird" | "night_owl" | "flexible"
  cleanliness  String   // "very_clean" | "somewhat_clean" | "flexible"
  smoking      Boolean  @default(false)
  partying     Boolean  @default(false)
  bio          String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// Marketplace Product model
model MarketplaceProduct {
  id            String   @id @default(cuid())
  title         String
  description   String   @db.Text
  price         Float
  location      String   // Where the item is located
  university    String?  // University where seller studies
  condition     String   // "like_new" | "excellent" | "good" | "fair"
  category      String   // "electronics" | "textbooks" | "furniture" | etc
  deliveryType  String?  // "pickup" | "delivery" | "both"
  images        String[] // JSON array of image URLs
  isAvailable   Boolean  @default(true) // Whether product is still for sale
  seller        User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId      String
  views         Int      @default(0)
  interested    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  savedBy       SavedProduct[]

  @@index([sellerId])
  @@index([category])
  @@index([location])
  @@index([university])
  @@index([isAvailable])
  @@index([createdAt])
}

// Saved Products model
model SavedProduct {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])

// Conversation model
model Conversation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  participants  ConversationParticipant[]
  messages      Message[]
}

// Conversation Participant (join table)
model ConversationParticipant {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

// Message model
model Message {
  id             String       @id @default(cuid())
  content        String
  sender         User         @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  createdAt      DateTime     @default(now())

  @@index([senderId])
  @@index([conversationId])
}

// Notification model
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   // "message" | "tour" | "listing" | "roommate" | "product"
  isRead    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Saved Items model
model SavedItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  itemType  String   // "listing" | "roommate" | "product"
  itemId    String   // ID of the listing, roommate profile, or product
  listing   Listing? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@index([itemType])
}
